# Contact delivery. These values stay on the server and are never sent to browsers.
# CONTACT_FROM must be an address on a domain verified in Resend; there is no fallback.
RESEND_API_KEY=re_replace_me
CONTACT_TO=destination@example.com
CONTACT_FROM=website@example.com

# Optional. If set, contact requests must originate from this exact site origin.
# CONTACT_ALLOWED_ORIGIN=https://builtbybrendan.com

# Access logging. One JSON line per response on stdout, collected by Alloy into Loki.
# Includes the visitor IP and country from Cloudflare's headers; Loki expires it at 30 days.
# ACCESS_LOG=false

# Trust Cloudflare's CF-Connecting-IP for the access log and contact rate limits.
# Defaults to true. Only set false if the origin is reachable by untrusted clients directly.
# TRUST_PROXY=false
