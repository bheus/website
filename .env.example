# Contact delivery. These values stay on the server and are never sent to browsers.
CONTACT_TO=destination@example.com
CONTACT_FROM=website@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=smtp-user
SMTP_PASS=replace-me

# Optional. If set, contact requests must originate from this exact site origin.
# CONTACT_ALLOWED_ORIGIN=https://builtbybrendan.com
