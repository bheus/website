#!/usr/bin/env bash
# Runs the integration suite before a push whose new commits touch the site.
# Enable once per clone: `git config core.hooksPath .githooks`. Skip with `git push --no-verify`.
set -euo pipefail

remote=$1
zero=0000000000000000000000000000000000000000
site_paths='^(src/|static/|server/|e2e/|index\.html$|prerender\.mjs$|vite\.config\.|package(-lock)?\.json$|playwright\.config\.js$)'

touches_site=false
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not "--remotes=$remote")
  else
    range=("$remote_sha..$local_sha")
  fi
  # grep reads to the end: with pipefail, `grep -q` quitting early would SIGPIPE git log.
  if git log --name-only --format= "${range[@]}" | grep -E "$site_paths" >/dev/null; then
    touches_site=true
  fi
done
$touches_site || exit 0

cd "$(git rev-parse --show-toplevel)"

# The suite renders the working tree, so it only vouches for the pushed commits
# when the site files in the tree are those commits.
if git status --porcelain --untracked-files=all | cut -c4- | grep -E "$site_paths" >/dev/null; then
  echo "pre-push: commit or stash the uncommitted site changes first, so the suite tests what is being pushed." >&2
  exit 1
fi

echo "pre-push: this push touches the site; running the integration suite (npm run test:e2e)..." >&2
if ! npm run test:e2e >&2; then
  echo "pre-push: integration suite failed, push blocked. If the visual change is intended, run \`npm run test:visual:update\`, review the PNGs in git diff and commit them." >&2
  exit 1
fi
