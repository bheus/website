{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [],
  "title": "builtbybrendan.com traffic",
  "uid": "bbb-traffic",
  "tags": [
    "website",
    "loki",
    "traffic"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "monitoring",
        "label": "Monitoring traffic",
        "type": "custom",
        "description": "Uptime Kuma and Docker's internal healthcheck together outnumber real traffic.",
        "query": "Hidden : | ua !~ `Uptime-Kuma.*|Wget`,Shown : | ua =~ `.*`",
        "options": [
          {
            "selected": true,
            "text": "Hidden",
            "value": "| ua !~ `Uptime-Kuma.*|Wget`"
          },
          {
            "selected": false,
            "text": "Shown",
            "value": "| ua =~ `.*`"
          }
        ],
        "current": {
          "selected": true,
          "text": "Hidden",
          "value": "| ua !~ `Uptime-Kuma.*|Wget`"
        },
        "multi": false,
        "includeAll": false,
        "skipUrlSync": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "description": "Respects the Monitoring traffic toggle.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"brendan-website\"} | json | __error__=\"\" ${monitoring:raw} [$__range]))",
          "legendFormat": "Requests",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "id": 1,
      "title": "Requests",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      }
    },
    {
      "description": "Fetches of the fingerprinted JS bundle \u2014 only a real browser requests it.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"brendan-website\"} | json | __error__=\"\" | path =~ `/assets/.*\\.js` [$__range]))",
          "legendFormat": "Browser page loads",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "queryType": "instant"
